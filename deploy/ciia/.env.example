# ── Copie para deploy/ciia/.env e preencha. O .env NUNCA vai para o Git (contém segredos). ──

# Endereço público do site (ex.: lupa.ciia.exemplo.br). Atrás de proxy da instituição: :80
DOMAIN=
HTTP_PORT=80
HTTPS_PORT=443

# Supabase — MESMO projeto da Vercel (mesmos usuários e dados) ou outro projeto (separado).
# Público (vai para o navegador):
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Só no servidor (SECRETO):
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWKS_URL=

# IA (SECRETO) — a mesma chave da Vercel divide a cota/custo com o site da Vercel
GROQ_API_KEY=
# OCR de PDF escaneado no servidor (opcional)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Administração por id de usuário (opcional; o normal é app_metadata.role=admin no Supabase)
LUPA_ADMIN_USER_IDS=
LUPA_ADMIN_REQUIRE_MFA=false

# Origens extras aceitas pelo CORS (o próprio domínio já é aceito)
ALLOWED_ORIGINS=

# Proxies à frente da API: 1 (só o Caddy) ou 2 (proxy da instituição + Caddy)
LUPA_TRUST_PROXY_HOPS=1

# Coleta automática: a Vercel já faz uma vez por dia. Deixe vazio aqui para não duplicar.
CRON_SECRET=

# Migrações: NUNCA ligue com o mesmo banco da Vercel (a integração GitHub → Supabase aplica).
LUPA_RUN_MIGRATIONS_ON_START=false

# Monitoramento de erros (opcional)
SENTRY_DSN=
VITE_SENTRY_DSN=

LOG_LEVEL=info
